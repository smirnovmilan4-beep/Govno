-- ============ Основной цикл ============
task.spawn(function()
    while true do
        task.wait(CHECK_INTERVAL)
        if not enabled then continue end
        if currentTarget and isAlive(currentTarget.obj) then continue end

        if killTimestamp > 0 then
            local since = os.clock() - killTimestamp
            if since < POST_KILL_WAIT then
                if actionLabel then
                    actionLabel.Text = string.format("Ожидание %.1fс...", POST_KILL_WAIT - since)
                    actionLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
                end
                continue
            end
            local newT = findNearest()
            if not newT then
                killTimestamp = 0
                enabled = false
                stopTracking()
                if actionLabel then
                    actionLabel.Text = string.format("Ждём меню %.1f сек...", MENU_WAIT_TIME)
                    actionLabel.TextColor3 = Color3.fromRGB(255, 120, 60)
                end
                task.wait(MENU_WAIT_TIME)
                if actionLabel then
                    actionLabel.Text = "Жесткий клик вниз..."
                    actionLabel.TextColor3 = Color3.fromRGB(255, 120, 60)
                end
                forceClickReplay()
                task.wait(2)
                if LP.Parent then
                    enabled = true
                    if toggle then
                        toggle.Text = "ВЫКЛЮЧИТЬ"
                        toggle.BackgroundColor3 = Color3.fromRGB(180, 40, 60)
                    end
                    if actionLabel then
                        actionLabel.Text = "Поиск..."
                        actionLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
                    end
                end
                continue
            end
            killTimestamp = 0
        end

        if waiting then continue end
        local t = findNearest()
        if t then
            waiting = true
            if actionLabel then
                actionLabel.Text = "Найден: " .. t.name
                actionLabel.TextColor3 = Color3.fromRGB(255, 220, 0)
            end
            task.wait(SPAWN_DELAY)
            if not enabled then waiting = false continue end
            if isAlive(t.obj) then
                waiting = false
                startTracking(t)
            else
                waiting = false
                killTimestamp = os.clock()
            end
        end
    end
end)
