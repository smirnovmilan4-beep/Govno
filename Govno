    title.Position = UDim2.new(0, 8, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "Vampire Hunter"
    title.TextColor3 = Color3.fromRGB(220, 180, 255)
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Active = true
    title.Parent = main

    toggle  = mkBtn("ВЫКЛЮЧИТЬ", 26, Color3.fromRGB(180, 40, 60))
    findBtn = mkBtn("Тест: Клик вниз", 56, Color3.fromRGB(90, 60, 140))

    actionLabel = Instance.new("TextLabel")
    actionLabel.Size = UDim2.new(1, -16, 0, 24)
    actionLabel.Position = UDim2.new(0, 8, 0, 88)
    actionLabel.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    actionLabel.BorderSizePixel = 0
    actionLabel.Text = "Поиск..."
    actionLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
