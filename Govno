        if forceClickReplay then forceClickReplay() end
        actionLabel.Text = "Клик сделан"
        actionLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
    end)
end

-- ============ Поиск Dio ============
local function nameMatches(n)
    n = n:lower()
    for _, k in ipairs(KEYS) do
        if n:find(k, 1, true) then return true end
    end
end
local function isAlive(inst)
    if not inst or not inst.Parent or not inst:IsDescendantOf(workspace) then return false end
    local h = inst:FindFirstChildOfClass("Humanoid")
    return not (h and h.Health <= 0)
end
local function getPos(inst)
    local hrp = inst:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    if inst.PrimaryPart then return inst.PrimaryPart.Position end
    local ok, cf = pcall(function() return inst:GetPivot() end)
    if ok then return cf.Position end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position or nil
end
local function findNearest()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Vector3.zero
    local best, bd = nil, math.huge
    for _, m in ipairs(workspace:GetDescendants()) do
        if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid")
            and m ~= LP.Character and nameMatches(m.Name) and isAlive(m) then
            local p = getPos(m)
            if p then
                local d = (p - myPos).Magnitude
                if d < bd then best, bd = {obj = m, name = m.Name}, d end
            end
        end
    end
    return best
end

-- ============ M1 / E / T ============
local function pressM1()
    local cam = workspace.CurrentCamera
    local vp = cam.ViewportSize
    local cx, cy = vp.X * 0.5, vp.Y * 0.5
    pcall(function()
        VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    end)
end
local function pressKey(k)
    pcall(function()
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(0.03)
        VIM:SendKeyEvent(false, k, false, game)
    end)
end
local function startAutoAttack(token)
    task.spawn(function()
        local lm, le, lt = 0, 0, 0
        while enabled and token == attackToken and currentTarget do
            if not isAlive(currentTarget.obj) then break end
            local now = os.clock()
            if now - lm >= M1_COOLDOWN then pressM1(); lm = now end
            if now - le >= E_COOLDOWN  then pressKey(Enum.KeyCode.E); le = now end
            if now - lt >= T_COOLDOWN  then pressKey(Enum.KeyCode.T); lt = now end
            task.wait(0.03)
        end
    end)
end

-- ============ Freeze ============
local function freezeChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    savedPlatformStand = hum.PlatformStand
    savedWalkSpeed     = hum.WalkSpeed
    hum.PlatformStand = true; hum.AutoRotate = false; hum.WalkSpeed = 0
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
end
local function unfreezeChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.PlatformStand = savedPlatformStand or false
    hum.AutoRotate = true
    hum.WalkSpeed = savedWalkSpeed or 16
    savedPlatformStand, savedWalkSpeed = nil, nil
end

function stopTracking()
    if trackConn then trackConn:Disconnect() end
    if camConn   then camConn:Disconnect()   end
    trackConn, camConn = nil, nil
    currentTarget, smoothedPos, attackToken = nil, nil, nil
    waiting = false
    unfreezeChar()
end

local function startTracking(t)
    stopTracking()
    currentTarget, teleportAccum, smoothedPos = t, 0, nil
    attackToken = {}
    freezeChar()
    if actionLabel then
        actionLabel.Text = "Атака: " .. t.name
        actionLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    end

    trackConn = RunService.Heartbeat:Connect(function(dt)
        if not enabled then return end
        if not isAlive(t.obj) then
            killTimestamp = os.clock()
            stopTracking()
            return
        end
        teleportAccum += dt
        if teleportAccum < 1 / TELEPORT_RATE then return end
        teleportAccum = 0
        local raw = getPos(t.obj)
        if not raw then return end
        smoothedPos = smoothedPos and smoothedPos:Lerp(raw, SMOOTH) or raw
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        char:PivotTo(CFrame.lookAt(smoothedPos + Vector3.new(0, HEIGHT_OFFSET, 0), raw))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    camConn = RunService.RenderStepped:Connect(function()
        if not enabled or not currentTarget or not isAlive(currentTarget.obj) then return end
        local targetPos = getPos(currentTarget.obj)
        if not targetPos then return end
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local myPos = hrp.Position
        local dir = (myPos - targetPos) * Vector3.new(1, 0, 1)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
        dir = dir.Unit
        local rightDir = dir:Cross(Vector3.new(0, 1, 0))
        local camPos = myPos + dir * CAM_DISTANCE + Vector3.new(0, CAM_HEIGHT, 0) + rightDir * CAM_RIGHT_OFFSET
        local lookAt = targetPos + Vector3.new(0, CAM_LOOK_UP, 0) - rightDir * CAM_RIGHT_OFFSET
        workspace.CurrentCamera.CFrame = CFrame.lookAt(camPos, lookAt)
    end)

    startAutoAttack(attackToken)
end

-- ============ ЖЕСТКИЙ КЛИК ============
function forceClickReplay()
    local vp = workspace.CurrentCamera.ViewportSize
    local w, h = vp.X, vp.Y
    local targetX = w * CLICK_X_PERCENT
    local targetY = h * CLICK_Y_PERCENT

    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        local btn = pg:FindFirstChild("ReplayButton", true)
            or pg:FindFirstChild("RetryButton", true)
        if btn then
            pcall(function() btn:Activate() end)
            pcall(function() btn.MouseButton1Click:Fire() end)
        end
    end

    for i = 1, 2 do
        pcall(function()
            VIM:SendMouseMoveEvent(targetX, targetY, game)
            task.wait(0.15)
            VIM:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
            task.wait(0.1)
            VIM:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
        end)
        task.wait(0.2)
    end
    return true
end

